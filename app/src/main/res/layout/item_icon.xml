<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="12dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/viewContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvName"
                style="@style/NunitoMedium.16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/textHighEm" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvViewAll"
                style="@style/NunitoMedium.14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_med_em"
                android:drawableEnd="@drawable/ic_arow_right"
                android:gravity="center_vertical"
                android:text="@string/view_all" />
        </LinearLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_150sdp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            app:shapeAppearance="@style/round_img_16" />

    </LinearLayout>

    <include
        android:id="@+id/viewLoading"
        layout="@layout/view_image_loading"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/viewContent"
        app:layout_constraintEnd_toEndOf="@id/viewContent"
        app:layout_constraintStart_toStartOf="@id/viewContent"
        app:layout_constraintTop_toTopOf="@id/viewContent" />
</androidx.constraintlayout.widget.ConstraintLayout>