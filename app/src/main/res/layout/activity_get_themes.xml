<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <FrameLayout
        android:id="@+id/adsSlotTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="ads_slot:get_theme_slot_top" />
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ads_weighted_content_height"
    android:layout_weight="1"
    android:background="@color/white"
    tools:context=".ui.theme.activities.GetThemeActivity">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackground"
            android:padding="12dp"
            android:src="@drawable/ic_back_1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            style="@style/NunitoExtraBold.24"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/get_themes"
            android:textColor="@color/accent_text" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnGoToHome"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?selectableItemBackground"
            android:padding="10dp"
            android:src="@drawable/ic_home"
            android:visibility="invisible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_segment_container"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tabWallpapers"
            style="@style/NunitoSemiBold.14"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_selected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/wallpapers"
            android:textColor="@color/text_tab_theme" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tabIcons"
            style="@style/NunitoSemiBold.14"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_selected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/icons"
            android:textColor="@color/text_tab_theme" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tabWidgets"
            style="@style/NunitoSemiBold.14"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_selected"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/widgets"
            android:textColor="@color/text_tab_theme" />


    </LinearLayout>

    <FrameLayout
        android:id="@+id/pageContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabContainer">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pageWallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/wallpaperFrame"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="36dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/border_12"
                android:elevation="2dp"
                android:padding="4dp"
                app:layout_constraintBottom_toTopOf="@id/viewGetWallpaper"
                app:layout_constraintDimensionRatio="9:16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="560dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintWidth_max="360dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:shapeAppearance="@style/round_img_12"
                    tools:src="@mipmap/ic_launcher" />

                <include
                    android:id="@+id/viewWallpaperLoading"
                    layout="@layout/view_image_loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/viewGetWallpaper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="24dp"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:id="@+id/viewApplied"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/wallpaperFrame">

                    <com.airbnb.lottie.LottieAnimationView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:padding="8dp"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="false"
                        app:lottie_rawRes="@raw/done" />

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/NunitoMedium.16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/applied"
                        android:textColor="@color/success_high_em" />

                </LinearLayout>

                <thinklife.prism.wallpaper.widget.theme.core.widget.IconTextButton
                    android:id="@+id/btnApplyWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:btnBackground="@drawable/bg_button_1"
                    app:btnIcon="@drawable/ic_download"
                    app:btnText="@string/download"
                    app:btnTextColor="@color/on_accent"
                    app:btnIconRight="@drawable/ic_ad" />

            </FrameLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pageIcons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcvIcons"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toTopOf="@id/btnInstallAll"
                app:layout_constraintTop_toTopOf="parent"
                tools:listitem="@layout/item_set_icon" />

            <thinklife.prism.wallpaper.widget.theme.core.widget.ServerLoadingView
                android:id="@+id/viewIconsLoading"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@color/white"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/btnInstallAll"
                app:layout_constraintTop_toTopOf="parent" />

            <thinklife.prism.wallpaper.widget.theme.core.widget.IconTextButton
                android:id="@+id/btnInstallAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="24dp"
                app:btnBackground="@drawable/bg_button_1"
                app:btnText="@string/install_all_icons"
                app:btnTextColor="@color/on_accent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:btnIconRight="@drawable/ic_ad" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pageWidgets"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/frameWidgetMedium"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="22dp"
                app:layout_constraintDimensionRatio="2:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivWidgetMedium"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    app:shapeAppearance="@style/round_img_12" />

                <include
                    android:id="@+id/viewWidgetMediumLoading"
                    layout="@layout/view_image_loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            </FrameLayout>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineWidgetCenter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <FrameLayout
                android:id="@+id/frameWidgetSmall"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toStartOf="@id/guidelineWidgetCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/frameWidgetMedium">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivWidgetSmall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    app:shapeAppearance="@style/round_img_12" />

                <include
                    android:id="@+id/viewWidgetSmallLoading"
                    layout="@layout/view_image_loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameWidgetLarge"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/guidelineWidgetCenter"
                app:layout_constraintTop_toBottomOf="@id/frameWidgetMedium">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivWidgetLarge"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    app:shapeAppearance="@style/round_img_12" />

                <include
                    android:id="@+id/viewWidgetLargeLoading"
                    layout="@layout/view_image_loading"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/themePager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <include
        android:id="@+id/viewApplyLoading"
        layout="@layout/view_loading_setwallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/adsSlotBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="ads_slot:get_theme_slot_bottom" />
</LinearLayout>
