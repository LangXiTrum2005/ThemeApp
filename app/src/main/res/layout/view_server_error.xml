<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_server_error" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvTitle"
        style="@style/NunitoBold.20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/could_not_load_content"
        android:textColor="@color/text_high_em" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvMessage"
        style="@style/NunitoMedium.14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/server_error_message"
        android:textColor="@color/text_med_em" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/btnRetry"
        style="@style/NunitoBold.14"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="34dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_button_1"
        android:gravity="center"
        android:text="@string/try_again"
        android:textColor="@color/on_accent" />

</merge>
