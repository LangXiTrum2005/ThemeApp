<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.theme.activities.PreviewThemeActivity">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?selectableItemBackground"
            android:padding="12dp"
            android:src="@drawable/ic_back_1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitle"
            style="@style/NunitoExtraBold.24"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/preview"
            android:textColor="@color/primary_high_em" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_preview_theme"
        app:layout_constraintBottom_toTopOf="@+id/btnGetThemes"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="20dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivWallpaper"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginEnd="5dp"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="0.5"
                app:layout_constraintEnd_toStartOf="@+id/ivTheme"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/round_img_12"
                tools:src="@mipmap/ic_launcher" />

            <include
                android:id="@+id/viewWallpaperLoading"
                layout="@layout/view_image_loading"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/ivWallpaper"
                app:layout_constraintEnd_toEndOf="@id/ivWallpaper"
                app:layout_constraintStart_toStartOf="@id/ivWallpaper"
                app:layout_constraintTop_toTopOf="@id/ivWallpaper" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivTheme"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="5dp"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="0.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivWallpaper"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/round_img_12"
                tools:src="@mipmap/ic_launcher" />

            <include
                android:id="@+id/viewThemeLoading"
                layout="@layout/view_image_loading"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/ivTheme"
                app:layout_constraintEnd_toEndOf="@id/ivTheme"
                app:layout_constraintStart_toStartOf="@id/ivTheme"
                app:layout_constraintTop_toTopOf="@id/ivTheme" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <com.wavez.themewallpaper.ui.customview.IconTextButton
        android:id="@+id/btnGetThemes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="32dp"
        app:btnBackground="@drawable/bg_button_1"
        app:btnText="@string/get_themes"
        app:layout_constraintBottom_toTopOf="@+id/banner_ads" />

    <com.ads.admob.banner_ads.BannerAdView
        android:id="@+id/banner_ads"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        />

    <com.wavez.themewallpaper.ads.native_ad.view.BigNativeCollapsibleAdTemplate
        android:id="@+id/nativePremiumTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
