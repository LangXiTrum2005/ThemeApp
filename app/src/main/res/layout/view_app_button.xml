<!--
  Ruột của AppButton. Dùng <merge> để không đẻ thêm một cấp ViewGroup: chính AppButton đã là
  LinearLayout ngang rồi.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:visibility="gone"
        tools:src="@drawable/ic_check_circle"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvText"
        style="@style/NunitoBold.16"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Get started" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivAdIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/app_button_ad_icon_description"
        android:src="@drawable/ic_ad_badge"
        android:visibility="gone"
        tools:visibility="visible" />

</merge>
