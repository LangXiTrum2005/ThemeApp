<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="36dp"
        android:background="@drawable/border_28"
        android:backgroundTint="@color/white"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/NunitoMedium.14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5sp"
            android:text="@string/downloading_please_wait_a_moment"
            android:textAlignment="center"
            android:textColor="@color/text_med_em"
            app:layout_constraintBottom_toBottomOf="@+id/ic3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ic3"
            app:layout_constraintTop_toTopOf="@+id/ic3" />


        <ProgressBar
            android:id="@+id/progress_limit"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:indeterminate="false"
            android:max="100"
            android:maxHeight="8dip"
            android:minHeight="8dip"
            android:progressDrawable="@drawable/progress_limit"
            app:layout_constraintTop_toBottomOf="@+id/tvDes" />


    </LinearLayout>

</LinearLayout>