<!--
  Nền chung của các màn trong luồng: tông pastel lavender hài hòa với app Theme & Wallpaper,
  kết hợp vệt ánh tím (#865CFA) và hồng phấn (#FF6DE9) nhẹ nhàng ở phía trên.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/bg_main" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#18865CFA"
                android:centerColor="#08865CFA"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#0DFF6DE9"
                android:centerX="0.85"
                android:centerY="0.10"
                android:endColor="@android:color/transparent"
                android:gradientRadius="480dp"
                android:startColor="#1EFF6DE9"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
