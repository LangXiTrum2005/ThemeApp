<!--
  Nền chung của các màn trong luồng: nền sáng + một vệt accent rất nhạt toả từ phía trên để màn
  không phẳng lì. Đổi chủ đề thì sửa đúng file này, layout không phải đụng tới.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/bg_main" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#0A0E9384"
                android:centerX="0.5"
                android:centerY="0.16"
                android:endColor="@android:color/transparent"
                android:gradientRadius="520dp"
                android:startColor="#1A0E9384"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
