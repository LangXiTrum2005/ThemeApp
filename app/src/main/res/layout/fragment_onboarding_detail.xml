<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_2"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/bgObd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_onboarding" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/imageIV"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toTopOf="@id/tvHeader"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/bg_walkthough_1" />

        <TextView
            android:id="@+id/tvHeader"
            style="@style/NunitoExtraBold.20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingHorizontal="12dp"
            android:textAlignment="center"
            android:textColor="@color/primary_high_em"
            app:layout_constraintBottom_toTopOf="@+id/tvDes"
            tools:text="Draw Anything Easily" />

        <TextView
            android:id="@+id/tvDes"
            style="@style/NunitoMedium.14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lines="2"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_high_em"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@+id/btnNext"
            tools:text="Boost FPS and reduce lag for a better experience with one click" />

        <include
            android:id="@+id/viewObd1"
            layout="@layout/view_onboarding_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/btnNext"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="40dp"
            android:background="@drawable/state_button_next"
            android:gravity="center"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toTopOf="@+id/viewAd">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/NunitoSemiBold.16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="@string/next"
                android:textColor="@color/white" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/viewAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.wavez.controllerwidget.ads.native_ad.view.BigNativeAdTemplate
                android:id="@+id/big_native_ad_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom" />

            <com.wavez.controllerwidget.ads.native_ad.view.BigNativeAdTemplate
                android:id="@+id/bigNativeClick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:visibility="gone" />

            <com.wavez.controllerwidget.ads.native_ad.view.BigNativeAdTemplate
                android:id="@+id/viewFake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:visibility="invisible" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>