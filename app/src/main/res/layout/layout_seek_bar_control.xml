<?xml version="1.0" encoding="utf-8"?>
<thinklife.prism.wallpaper.widget.theme.core.controllercenter.view.CustomPullView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pullBar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:tag="layout/hd_layout_seek_bar_control_0">

    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</thinklife.prism.wallpaper.widget.theme.core.controllercenter.view.CustomPullView>