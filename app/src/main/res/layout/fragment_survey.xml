<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- AdsHub: slot neo cứng NGOÀI vùng scroll, không bao giờ đè nội dung -->
    <FrameLayout
        android:id="@+id/onb1SlotTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="ads_slot:onb1_slot_top" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent">

        <TextView
            android:id="@+id/tvTitle"
            style="@style/NunitoExtraBold.24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/what_s_your_vibe"
            android:textAlignment="center"
            android:textColor="@color/primary_high_em"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOptions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/btnNext"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            app:spanCount="2"
            tools:itemCount="4"
            tools:listitem="@layout/item_survey_option" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnNext"
            style="@style/NunitoBold.16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="28dp"
            android:background="@drawable/state_button_next"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="@string/next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:layout_constraintBottom_toTopOf="@+id/adsLanSlots" />

        <!-- AdsHub: vị trí CUỐI content. adsSlotOnb1ClickEnd cố ý KHÔNG gắn tag —
             trạng thái sau khi user chọn option đầu tiên render tay. -->
        <LinearLayout
            android:id="@+id/adsLanSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <FrameLayout
                android:id="@+id/adsSlotOnb1End"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:tag="ads_slot:onb1_slot_end" />

            <FrameLayout
                android:id="@+id/adsSlotOnb1ClickEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/onb1SlotBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="ads_slot:onb1_slot_bottom" />
</LinearLayout>
