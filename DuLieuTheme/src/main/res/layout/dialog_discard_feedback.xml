<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/border_28"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">


        <androidx.appcompat.widget.AppCompatTextView
            style="@style/NunitoExtraBold.20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/discard_changes"
            android:textAlignment="center"
            android:textColor="@color/textHighEm" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/NunitoMedium.14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/are_you_sure_you_want_to_discard_your_feedback"
            android:textAlignment="center"
            android:textColor="@color/textMedEm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.wavez.themewallpaper.ui.customview.IconTextButton
                android:id="@+id/btnDiscard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                app:btnBackground="@drawable/bg_button_outline_1"
                app:btnText="@string/discard"
                app:btnTextColor="@color/primary_high_em" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <com.wavez.themewallpaper.ui.customview.IconTextButton
                android:id="@+id/btnKeepEditing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                app:btnBackground="@drawable/bg_button_1"
                app:btnText="@string/keep_editing" />

        </LinearLayout>


    </LinearLayout>
</LinearLayout>