<!-- Vệt Rose dùng cùng palette primary để màu nhấn giữa các màn nhất quán. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/bg_main" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/screen_primary_glow_start"
                android:centerColor="@color/screen_primary_glow_center"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="@color/screen_secondary_glow_center"
                android:centerX="0.85"
                android:centerY="0.10"
                android:endColor="@android:color/transparent"
                android:gradientRadius="480dp"
                android:startColor="@color/screen_secondary_glow_start"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
