<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="36dp"
        android:background="@drawable/border_16"
        android:backgroundTint="@color/surface_1"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/ic_buy_succes" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/NunitoSemiBold.24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:text="@string/payment_success"
                android:textAlignment="center"
                android:textColor="@color/onBackground"
                app:layout_constraintBottom_toBottomOf="@+id/ic3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ic3"
                app:layout_constraintTop_toTopOf="@+id/ic3" />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/text_secondary_14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="5sp"
                android:text="@string/your_premium_version"
                android:textAlignment="center"
                android:textColor="@color/onBackground"
                app:layout_constraintBottom_toBottomOf="@+id/ic3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ic3"
                app:layout_constraintTop_toTopOf="@+id/ic3" />

            <TextView
                android:id="@+id/btnGotIt"
                style="@style/text_primary_header_14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_1"
                android:gravity="center"
                android:paddingHorizontal="32dp"
                android:paddingVertical="12dp"
                android:text="@string/got_it"
                android:textColor="@color/white" />
        </LinearLayout>


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>