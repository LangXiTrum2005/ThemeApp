<?xml version="1.0" encoding="utf-8"?>
<ripple android:color="@color/accent_soft" xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_pressed" />
                    <corners android:radius="@dimen/_100sdp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/primary_med_em" />
                    <corners android:radius="@dimen/_100sdp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>