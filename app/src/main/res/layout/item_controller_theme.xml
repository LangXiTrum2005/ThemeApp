<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_controller_theme_selector"
    android:orientation="vertical"
    android:padding="3dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivTheme"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvThemeName"
        style="@style/NunitoBold.12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingVertical="6dp"
        android:textColor="@color/textHighEm" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnThemeAction"
        style="@style/NunitoBold.12"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_button_grant"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressThemeAction"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />
</LinearLayout>
