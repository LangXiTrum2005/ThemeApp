<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false">
        <shape>
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/surfacePrimaryLowEm" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="#6635F2" />
                    <stroke android:width="1dp" android:color="#5524DD" />
                    <corners android:radius="16dp" />
                </shape>
            </item>

            <item android:bottom="2.5dp" android:end="1dp" android:start="1dp" android:top="1dp">
                <shape>
                    <solid android:color="@color/surfacePrimaryLowEm" />
                    <stroke android:width="1dp" android:color="@color/primary_high_em" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>

    </item>
</selector>