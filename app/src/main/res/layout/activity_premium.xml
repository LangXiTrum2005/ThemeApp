<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF5FB"
    android:orientation="vertical"
    tools:context=".ui.premium.PremiumActivity">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:src="@drawable/img_premium_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_16sdp"
        android:src="@drawable/btn_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/NunitoExtraBold.24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="12dp"
        android:text="@string/unlock_premium"
        android:textAlignment="center"
        android:textColor="@color/primary_high_em"
        app:layout_constraintBottom_toBottomOf="@+id/background" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@+id/viewButton"
        app:layout_constraintTop_toBottomOf="@+id/background">

        <LinearLayout
            android:id="@+id/viewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTitle1"
                    style="@style/NunitoMedium.14"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/border_12"
                    android:drawableTop="@drawable/ic_vip_des_1"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:minLines="2"
                    android:padding="8dp"
                    android:text="@string/_100_no_ads"
                    android:textColor="@color/color2" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTitle2"
                    style="@style/NunitoMedium.14"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/border_12"
                    android:drawableTop="@drawable/ic_vip_des_2"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:minLines="2"
                    android:padding="8dp"
                    android:text="@string/premium_themes"
                    android:textColor="@color/color2" />

                <Space
                    android:layout_width="8dp"
                    android:layout_height="wrap_content" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tvTitle3"
                    style="@style/NunitoMedium.14"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/border_12"
                    android:drawableTop="@drawable/ic_vip_des_3"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:minLines="2"
                    android:padding="8dp"
                    android:text="@string/unlimited_wallpapers"
                    android:textColor="@color/color2" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/viewBuy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="visible"
                app:layout_constraintBottom_toTopOf="@+id/viewButton">

                <LinearLayout
                    android:id="@+id/btnBuyWeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvSave"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:background="@drawable/bg_border_vip_1"
                        android:paddingHorizontal="@dimen/_11sdp"
                        android:paddingVertical="@dimen/_2sdp"
                        android:text="@string/most_popular"
                        android:textAllCaps="true"
                        android:textColor="@color/state_color_most"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/state_button_buy_premium_2"
                        android:gravity="center"
                        android:minHeight="68dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="20dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/NunitoBold.16"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="1"
                            android:text="@string/weekly"
                            android:textColor="@color/state_color_premium" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvPriceWeek"
                            style="@style/NunitoBold.16"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:textColor="@color/state_color_premium"
                            android:textSize="14sp"
                            tools:text="$0.xx" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnBuyMonth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/state_button_buy_premium"
                    android:gravity="center"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="20dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/NunitoBold.16"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:text="@string/monthly"
                        android:textColor="@color/state_color_premium" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvPriceMonth"
                        style="@style/NunitoBold.16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="$0.xx"
                        android:textColor="@color/state_color_premium" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnBuyYear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/state_button_buy_premium"
                    android:gravity="center"
                    android:minHeight="68dp"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:paddingHorizontal="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/NunitoBold.16"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="@string/yearly"
                            android:textColor="@color/state_color_premium" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvDayFree"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="4dp"
                            android:text="@string/_3_day_free_trial"
                            android:textColor="@color/textMedEm"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvPriceYear"
                        style="@style/NunitoBold.16"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="$0.xx"
                        android:textColor="@color/state_color_premium" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/viewError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/border_16"
                android:backgroundTint="@color/danger_base_em"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/viewButton">

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/NunitoBold.18"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_failed"
                    android:text="@string/something_went_wrong"
                    android:textAlignment="center"
                    android:textColor="@color/danger_high_em" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    style="@style/NunitoMedium.14"
                    android:text="@string/tv_des_failed_buy"
                    android:textColor="@color/text_high_em" />

            </LinearLayout>


        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/viewButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGetPremium"
            style="@style/NunitoBold.16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:background="@drawable/bg_button_1"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/start_free_trial"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTryAgain"
            style="@style/NunitoBold.16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:background="@drawable/bg_button_1"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:text="@string/try_again"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/cancel_anytime"
            android:textColor="@color/text_low_em" />

        <LinearLayout
            android:id="@+id/viewBottomMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvTermsOfUse"
                style="@style/NunitoMedium.12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terms_of_use"
                android:textColor="@color/textLowEm" />

            <View
                android:layout_width="32dp"
                android:layout_height="8dp"
                android:layout_marginHorizontal="@dimen/_6sdp"
                android:background="@color/base_em"
                android:visibility="invisible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPrivacy"
                style="@style/NunitoMedium.12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_policy"
                android:textColor="@color/textLowEm" />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>