<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_2"
    tools:context=".ui.setting.SettingActivity">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_back_1" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/NunitoExtraBold.24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/setting"
            android:textColor="@color/primary_high_em" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardSettings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_setting_card"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnLanguage"
            style="@style/NunitoMedium.16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_setting_language"
            android:drawablePadding="12dp"
            android:padding="12dp"
            android:text="@string/language"
            android:textColor="@color/textMedEm" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline_base_em" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnFeedback"
            style="@style/NunitoMedium.16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_setting_feedback"
            android:drawablePadding="12dp"
            android:padding="12dp"
            android:text="@string/feedback"
            android:textColor="@color/textMedEm" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline_base_em" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnRate"
            style="@style/NunitoMedium.16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_setting_rate"
            android:drawablePadding="12dp"
            android:padding="12dp"
            android:text="@string/rate_us"
            android:textColor="@color/textMedEm" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/outline_base_em" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btnPrivacy"
            style="@style/NunitoMedium.16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawableStart="@drawable/ic_setting_privacy"
            android:drawablePadding="12dp"
            android:padding="12dp"
            android:text="@string/privacy_policy"
            android:textColor="@color/textMedEm" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
