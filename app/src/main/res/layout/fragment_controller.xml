<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/transparent"
    tools:context=".ui.home.fragment.controller.ControllerFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/controllerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="0dp"
            android:paddingBottom="24dp">

            <!-- Hero Card: Control Center Status & Preview -->
            <LinearLayout
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_controller"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_badge_active"
                        android:padding="8dp"
                        android:src="@drawable/ic_tab_controller_checked"
                        app:tint="@color/surfacePrimaryHighEm" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvControlCenterTitle"
                            style="@style/NunitoExtraBold.18"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/control_center"
                            android:textColor="@color/textHighEm" />

                        <TextView
                            android:id="@+id/tvControlCenterDesc"
                            style="@style/NunitoMedium.12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/control_center_desc"
                            android:textColor="@color/textMedEm" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvServiceStatusBadge"
                        style="@style/NunitoBold.12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_inactive"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/controller_service_inactive"
                        android:textColor="@color/surfaceDangerHighEm" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#F0EEFA" />

                <TextView
                    android:id="@+id/tvThemeStatus"
                    style="@style/NunitoMedium.12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="@string/controller_theme_status_checking"
                    android:textColor="@color/textMedEm" />

                <TextView
                    android:id="@+id/tvHintGesture"
                    style="@style/NunitoBold.12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/swipe_down_hint"
                    android:textColor="@color/textLowEm" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTogglePanel"
                    style="@style/NunitoBold.14"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button_grant"
                    android:text="@string/test_control_panel"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvControllerThemesTitle"
                style="@style/NunitoBold.16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/controller_themes"
                android:textColor="@color/textHighEm" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvControllerThemes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/layout_anim_grid_fall_down"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="3dp"
                android:paddingBottom="24dp"
                android:paddingTop="0dp" />



        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
