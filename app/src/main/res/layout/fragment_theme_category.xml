<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <FrameLayout
        android:id="@+id/adsSlotTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="ads_slot:theme_category_slot_top" />
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="@dimen/ads_weighted_content_height"
    android:layout_weight="1"
    android:background="@color/transparent"
    >

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvTheme"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_anim_grid_fall_down"
        android:overScrollMode="never"
        android:paddingHorizontal="7dp"
        android:paddingTop="6dp"
        android:paddingBottom="24dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="3"
        tools:listitem="@layout/item_theme" />

    <thinklife.prism.wallpaper.widget.theme.core.widget.ServerErrorView
        android:id="@+id/viewError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <thinklife.prism.wallpaper.widget.theme.core.widget.ServerLoadingView
        android:id="@+id/viewLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
    <FrameLayout
        android:id="@+id/adsSlotBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="ads_slot:theme_category_slot_bottom" />
</LinearLayout>
