<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.search.SearchActivity">

    <LinearLayout
        android:id="@+id/viewSearch"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edSearch"
            style="@style/NunitoMedium.16"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input"
            android:drawableEnd="@drawable/ic_search"
            android:hint="@string/search_themes"
            android:imeOptions="actionSearch"
            android:includeFontPadding="true"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:textColor="@color/text_high_em"
            android:textColorHint="@color/text_low_em" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="0dp"
            android:src="@drawable/ic_close_rectang" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvPopularTitle"
        style="@style/NunitoSemiBold.18"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:includeFontPadding="false"
        android:text="@string/most_popular"
        android:textColor="@color/text_high_em"
        app:layout_constraintStart_toStartOf="@+id/viewSearch"
        app:layout_constraintTop_toBottomOf="@+id/viewSearch" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvPopular"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintStart_toStartOf="@+id/tvPopularTitle"
        app:layout_constraintTop_toBottomOf="@+id/tvPopularTitle"
        tools:itemCount="4"
        tools:listitem="@layout/item_search_chip" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvNewestTitle"
        style="@style/NunitoSemiBold.18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/newest_themes"
        android:textColor="@color/text_high_em"
        app:layout_constraintStart_toStartOf="@id/rcvPopular"
        app:layout_constraintTop_toBottomOf="@+id/rcvPopular" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvThemes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNewestTitle"
        app:spanCount="2"
        tools:itemCount="4"
        tools:listitem="@layout/item_theme" />

    <LinearLayout
        android:id="@+id/viewEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNewestTitle"
        app:layout_constraintVertical_bias="0.3"
        tools:visibility="visible">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_search_empty" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvEmpty"
            style="@style/NunitoMedium.16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:textColor="@color/text_high_em"
            tools:text="No results found for\n&quot;Anime&quot;" />

    </LinearLayout>

    <com.wavez.controllerwidget.ui.customview.ServerLoadingView
        android:id="@+id/viewLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewSearch" />

    <com.wavez.controllerwidget.ui.customview.ServerErrorView
        android:id="@+id/viewError"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewSearch" />

</androidx.constraintlayout.widget.ConstraintLayout>
