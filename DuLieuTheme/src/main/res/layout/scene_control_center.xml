<?xml version="1.0" encoding="utf-8"?>
<com.wavez.themewallpaper.core.controllercenter.view.CustomPullView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pullRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="100dp"
    android:tag="layout/hd_scene_control_center_0">

    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4190d3"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.wavez.themewallpaper.core.controllercenter.view.HomeCenterControllerView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_48sdp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/layoutNotification"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main" />

    <LinearLayout
        android:id="@+id/focusDurationPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/focus15s"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_focus_duration"
            android:gravity="center"
            android:text="15s"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/focus30s"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_focus_duration"
            android:gravity="center"
            android:text="30s"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/focus1m"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_focus_duration"
            android:gravity="center"
            android:text="1m"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/focus2m"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_focus_duration"
            android:gravity="center"
            android:text="2m"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/focus5m"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_focus_duration"
            android:gravity="center"
            android:text="5m"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/focus10m"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_focus_duration"
            android:gravity="center"
            android:text="10m"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/focus30m"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_focus_duration"
            android:gravity="center"
            android:text="30m"
            android:textColor="@color/white"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#fff"
        android:visibility="gone"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent" />
</com.wavez.themewallpaper.core.controllercenter.view.CustomPullView>
