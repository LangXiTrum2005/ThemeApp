<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    tools:context=".ui.home.fragment.controller.ControllerFragment">

    <include
        android:id="@+id/toolbar"
        layout="@layout/view_tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Hero Card: Control Center Status & Preview -->
            <LinearLayout
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_controller"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_badge_active"
                        android:padding="8dp"
                        android:src="@drawable/ic_tab_controller_checked"
                        app:tint="@color/surfacePrimaryHighEm" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvControlCenterTitle"
                            style="@style/NunitoExtraBold.18"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/control_center"
                            android:textColor="@color/textHighEm" />

                        <TextView
                            android:id="@+id/tvControlCenterDesc"
                            style="@style/NunitoMedium.12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/control_center_desc"
                            android:textColor="@color/textMedEm" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvServiceStatusBadge"
                        style="@style/NunitoBold.12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_inactive"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="INACTIVE"
                        android:textColor="@color/surfaceDangerHighEm" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#F0EEFA" />

                <TextView
                    android:id="@+id/tvThemeStatus"
                    style="@style/NunitoMedium.12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:text="Theme status: Checking…"
                    android:textColor="@color/textMedEm" />

                <TextView
                    android:id="@+id/tvHintGesture"
                    style="@style/NunitoBold.12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/swipe_down_hint"
                    android:textColor="@color/textLowEm" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTogglePanel"
                    style="@style/NunitoBold.14"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button_grant"
                    android:text="@string/test_control_panel"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Permissions Section Title -->
            <TextView
                android:id="@+id/tvPermissionsTitle"
                style="@style/NunitoBold.16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:text="Required Permissions"
                android:textColor="@color/textHighEm" />

            <!-- Permissions Card -->
            <LinearLayout
                android:id="@+id/cardPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_controller"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Accessibility Service -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/NunitoBold.14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/accessibility_service"
                            android:textColor="@color/textHighEm" />

                        <TextView
                            style="@style/NunitoBold.12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/accessibility_service_desc"
                            android:textColor="@color/textMedEm" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnGrantAccessibility"
                        style="@style/NunitoBold.12"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_grant"
                        android:paddingHorizontal="14dp"
                        android:text="@string/enable_service"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tvAccessibilityGranted"
                        style="@style/NunitoBold.12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_active"
                        android:drawableStart="@drawable/ic_check_circle"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/permission_granted"
                        android:textColor="@color/textSuccessHighEm"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#F0EEFA" />

                <!-- 2. Write System Settings -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/NunitoBold.14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/write_settings_permission"
                            android:textColor="@color/textHighEm" />

                        <TextView
                            style="@style/NunitoBold.12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/write_settings_permission_desc"
                            android:textColor="@color/textMedEm" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnGrantWriteSettings"
                        style="@style/NunitoBold.12"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_grant"
                        android:paddingHorizontal="14dp"
                        android:text="@string/grant_permission"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tvWriteSettingsGranted"
                        style="@style/NunitoBold.12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_active"
                        android:drawableStart="@drawable/ic_check_circle"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/permission_granted"
                        android:textColor="@color/textSuccessHighEm"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#F0EEFA" />

                <!-- 3. Notification Access -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/NunitoBold.14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/notification_access"
                            android:textColor="@color/textHighEm" />

                        <TextView
                            style="@style/NunitoBold.12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/notification_access_desc"
                            android:textColor="@color/textMedEm" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnGrantNotification"
                        style="@style/NunitoBold.12"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_grant"
                        android:paddingHorizontal="14dp"
                        android:text="@string/grant_permission"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tvNotificationGranted"
                        style="@style/NunitoBold.12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_active"
                        android:drawableStart="@drawable/ic_check_circle"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/permission_granted"
                        android:textColor="@color/textSuccessHighEm"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#F0EEFA" />

                <!-- 4. Runtime Permissions (Camera / Bluetooth / Notification) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/NunitoBold.14"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System Toggles"
                            android:textColor="@color/textHighEm" />

                        <TextView
                            style="@style/NunitoBold.12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Camera (flashlight) and Bluetooth permissions"
                            android:textColor="@color/textMedEm" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnGrantRuntime"
                        style="@style/NunitoBold.12"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_grant"
                        android:paddingHorizontal="14dp"
                        android:text="@string/grant_permission"
                        android:textAllCaps="false"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tvRuntimeGranted"
                        style="@style/NunitoBold.12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_active"
                        android:drawableStart="@drawable/ic_check_circle"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="@string/permission_granted"
                        android:textColor="@color/textSuccessHighEm"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/NunitoBold.16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:text="@string/controller_themes"
                android:textColor="@color/textHighEm" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvControllerThemes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Guide Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_controller"
                android:elevation="1dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/NunitoBold.14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Instructions"
                    android:textColor="@color/textHighEm" />

                <TextView
                    style="@style/NunitoBold.12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="1. Grant Accessibility Service to start the overlay.\n2. Look for the pill handle anchored to the top of your screen.\n3. Drag down anytime from any app to access volume, brightness, wifi, music, and tools."
                    android:textColor="@color/textMedEm" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
