<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/selector_bg_language"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivFlag"
        android:layout_width="40dp"
        android:layout_height="28dp"
        android:scaleType="centerCrop"
        app:shapeAppearance="@style/round_img_8"
        app:strokeColor="#18000000"
        app:strokeWidth="0.8dp"
        tools:src="@drawable/flag_lan_vn" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLanguage"
            style="@style/NunitoBold.16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/selector_language_title"
            tools:text="Tiếng Việt" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvLanguageEn"
            style="@style/NunitoMedium.12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/selector_language_subtitle"
            tools:text="Vietnamese" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivRadioCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:duplicateParentState="true"
        android:src="@drawable/selector_language_radio" />

</LinearLayout>