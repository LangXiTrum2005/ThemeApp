<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_list_item"
    android:clickable="true"
    android:elevation="1dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivFlag"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_flag"
            android:contentDescription="@null"
            android:padding="8dp"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_flag_us" />

        <!-- textDirection="ltr": ép mọi tên ngôn ngữ (kể cả RTL) bắt đầu từ mép trái cho thẳng hàng. -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvName"
            style="@style/NunitoBold.16"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="textStart"
            android:textColor="@color/text_primary"
            android:textDirection="ltr"
            tools:text="United States" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivCheck"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_language_radio_unselected" />
    </LinearLayout>

</FrameLayout>
