<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <gradient android:endColor="@color/accent_gradient_end" android:startColor="@color/accent_gradient_start" android:type="linear" />
                    <corners android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp" android:topRightRadius="12dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:end="2dp" android:start="2dp" android:top="2dp">
                <shape>
                    <solid android:color="@color/surfacePrimaryBaseEm" />
                    <corners android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp" android:topRightRadius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="false">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp" android:topRightRadius="12dp" />
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="@color/surfacePrimaryLowEm" />
        </shape>
    </item>
</selector>