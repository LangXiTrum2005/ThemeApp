<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/state_item_habits"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivOptionIcon"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="2:1.4"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/round_img_16"
            tools:src="@drawable/obd_img_anime" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvOption"
            style="@style/NunitoSemiBold.16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:maxLines="1"
            android:paddingVertical="4dp"
            android:textAlignment="center"
            android:textColor="@color/text_state_onboarding"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/ivOptionIcon"
            app:layout_constraintStart_toStartOf="@+id/ivOptionIcon"
            app:layout_constraintTop_toBottomOf="@+id/ivOptionIcon"
            tools:text="🌸 Anime" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
