<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/shimmer_container"
    android:background="@color/white">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerNative"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2D254D"
        app:shimmer_auto_start="true"
        app:shimmer_base_alpha="0.3"
        app:shimmer_duration="1000"
        app:shimmer_highlight_alpha="1.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/border_12"
            android:backgroundTint="#2D254D"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <View
                android:id="@+id/viewContent"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/shimmer_item_rounded"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/viewContent1"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/shimmer_item_rounded"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@+id/viewContent" />

            <View
                android:id="@+id/media_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="12dp"
                android:background="@drawable/shimmer_item_rounded"
                app:layout_constraintBottom_toTopOf="@+id/call_to_action_view"
                app:layout_constraintTop_toBottomOf="@+id/viewContent1" />

            <View
                android:id="@+id/call_to_action_view"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/shimmer_item_rounded"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</FrameLayout>